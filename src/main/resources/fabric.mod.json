    "SakuraFX"
  ],
  "contact": {
    "issues": "https://github.com/Walksy/CustomHitboxes/issues",
    "sources": "https://github.com/Walksy/CustomHitboxes",
    "homepage": "https://discord.com/invite/zeu7uNuBWY"
  },
  "license": "MIT",
  "icon": "assets/walksy/icon.png",
